# sim_fingerprint.cmake: the cross-play "simulation fingerprint" (docs/CROSS_PLATFORM_ONLINE.md, Lobby).
#
# Run in script mode by the build (CMakeLists.txt) only for cross-play builds (PARTYBOARD_NO_FMA and
# PARTYBOARD_SHARED_MATH both ON):
#   cmake -DROOT=<source dir> -DLIST=<file listing the inputs, one relative path per line>
#         -DOPTIONS=<simulation options text> -DREVISION=<git revision> -DOUT=<header> -P sim_fingerprint.cmake
#
# It hashes every game-relevant source file (path + content; text files with CR LF read as LF so a
# Windows checkout matches a Mac one) and writes a header with the result. Two copies built on
# different computers from the same sources with the same options carry the same fingerprint; the
# lobby uses it to accept a Mac/Windows pair whose binaries can never be byte-identical. The header
# is rewritten only when the result changes, so an unchanged tree does not recompile anything.
cmake_minimum_required(VERSION 3.20)
foreach (required ROOT LIST OPTIONS OUT)
    if (NOT DEFINED ${required})
        message(FATAL_ERROR "sim_fingerprint.cmake: ${required} not given")
    endif ()
endforeach ()

file(STRINGS "${LIST}" sim_files)
set(sim_manifest "")
set(sim_count 0)
foreach (sim_rel IN LISTS sim_files)
    if (sim_rel STREQUAL "")
        continue()
    endif ()
    set(sim_path "${ROOT}/${sim_rel}")
    if (NOT EXISTS "${sim_path}")
        message(FATAL_ERROR "sim_fingerprint.cmake: ${sim_rel} is listed but missing; re-run CMake")
    endif ()
    # Text sources: compare by content with line endings normalised. Anything else byte for byte.
    if (sim_rel MATCHES "\\.(c|h|cpp|hpp|cc|cp|inc|cmake|patch|txt|m|mm|s|def|map)$")
        file(READ "${sim_path}" sim_text)
        string(REPLACE "\r\n" "\n" sim_text "${sim_text}")
        string(SHA256 sim_hash "${sim_text}")
    else ()
        file(SHA256 "${sim_path}" sim_hash)
    endif ()
    string(APPEND sim_manifest "${sim_rel} ${sim_hash}\n")
    math(EXPR sim_count "${sim_count} + 1")
endforeach ()
string(SHA256 sim_sources "${sim_manifest}")

set(sim_header "// Generated by cmake/sim_fingerprint.cmake; do not edit.\n")
string(APPEND sim_header "#pragma once\n")
string(APPEND sim_header "#define PARTYBOARD_SIM_SOURCES_SHA256 \"${sim_sources}\"\n")
string(APPEND sim_header "#define PARTYBOARD_SIM_SOURCE_FILES ${sim_count}\n")
string(APPEND sim_header "#define PARTYBOARD_SIM_OPTIONS \"${OPTIONS}\"\n")
string(APPEND sim_header "#define PARTYBOARD_SIM_REVISION \"${REVISION}\"\n")

set(sim_old "")
if (EXISTS "${OUT}")
    file(READ "${OUT}" sim_old)
endif ()
if (NOT sim_old STREQUAL sim_header)
    file(WRITE "${OUT}" "${sim_header}")
    message(STATUS "Cross-play simulation fingerprint: sources ${sim_sources} (${sim_count} files), ${OPTIONS}")
endif ()
# Kept for the build log and for comparing two machines by hand.
file(WRITE "${OUT}.manifest.txt" "${sim_manifest}")
